{
  "name": "open-sea-skin-dsh",
  "version": "2.0.6",
  "type": "module",
  "description": "实时海洋皮肤 · Realtime ocean theme for DeepSeek Harness Desktop and Web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeckChiang/open-sea-skin.git"
  },
  "homepage": "https://github.com/BeckChiang/open-sea-skin",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/BeckChiang/open-sea-skin/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "skin",
    "webgpu",
    "ocean"
  ],
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/index.js",
    "plugin/client.js",
    "cordis.patch.yml",
    "native-dist/loader.js",
    "native-dist/ocean.js",
    "native-dist/solar.js",
    "native-dist/sky.js",
    "native-dist/sky-astro.js",
    "native-dist/stars-data.js",
    "native-dist/stars-catalog.js",
    "native-dist/skin.html",
    "native-dist/styles.css",
    "native-dist/vendor/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "gen:stars": "node scripts/gen-stars-catalog.mjs",
    "check:generated": "node scripts/build-runtime.mjs --check",
    "prepublishOnly": "npm run build && npm run check:generated",
    "test": "node tests/structure.test.mjs && node tests/fleet.test.mjs && node tests/stars.test.mjs && node tests/sky.test.mjs && node tests/solar.test.mjs && node tests/sky-astro.test.mjs",
    "check": "npm run check:generated && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "BeckChiang"
}
